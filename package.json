{
  "name": "rocksoul-community",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/contracts.test.mjs",
    "test:e2e": "playwright test",
    "ci": "npm run validate && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@rocksoul/ui": "github:bjo163/rocksoul-ui#6a98ce0d5f5be60d4744f073837cd754639ea044",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11.6.0"
  },
  "packageManager": "npm@11.6.0"
}
